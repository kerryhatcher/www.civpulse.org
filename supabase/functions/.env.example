# Server-only publish function configuration. Copy to a gitignored env file.
# Use a separate test Worker/hook for local testing; never use production in QA.
CLOUDFLARE_ACCOUNT_ID=your_32_character_account_id
CLOUDFLARE_WORKER_TAG=your_32_character_worker_tag
# User-owned API token: Workers Builds Configuration -> Read, one account only.
# Account-owned tokens cannot authenticate to the Workers Builds API.
CLOUDFLARE_BUILDS_READ_TOKEN=your_account_scoped_workers_ci_read_token
CLOUDFLARE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/workers/builds/deploy_hooks/your_hook_uuid
# Replace with the actual local Astro origin. Omit this override in production
# to use the default www.civpulse.org and new.civpulse.org origins.
PUBLISH_ALLOWED_ORIGINS=http://localhost:4321
