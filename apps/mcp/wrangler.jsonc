{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "civpulse-mcp",
  "main": "src/legacy-redirect.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    {
      "pattern": "mcp.civpulse.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
