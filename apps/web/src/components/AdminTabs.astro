---
const path = Astro.url.pathname.replace(/\/+$/, '');

const tabs = [
  { href: '/admin/publish/', label: 'Publish' },
  { href: '/admin/requests/', label: 'Records requests' },
  { href: '/history/', label: 'Audit log' },
  { href: '/admin/users/', label: 'Users' },
  { href: '/admin/organizations/', label: 'Organizations' },
  { href: '/admin/people/', label: 'People' },
  { href: '/admin/offices/', label: 'Offices' },
  { href: '/admin/articles/', label: 'Articles' },
  { href: '/admin/layers/', label: 'Layers' },
  { href: '/admin/maps/', label: 'Maps' },
  { href: '/admin/calendars/', label: 'Calendars' },
  { href: '/admin/meetings/', label: 'Meetings' },
  { href: '/admin/elections/', label: 'Elections' },
];

const isCurrent = (href: string) => href.replace(/\/+$/, '') === path;
---

<nav class="admin-tabs" aria-label="Admin sections">
  {
    tabs.map((tab) => (
      <a href={tab.href} aria-current={isCurrent(tab.href) ? 'page' : undefined}>
        {tab.label}
      </a>
    ))
  }
</nav>
