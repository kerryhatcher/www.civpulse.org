---
import { provenanceDates, provenanceExplanation, recordSourceUrl, type ProvenanceSource } from '../lib/record-provenance';
interface Props { title?: string; sources?: ProvenanceSource[]; recordDate?: { label: string; value: string }; note?: string; publishedOn?: string | null; fetchedOn?: string | null }
const { title = 'Sources and verification', sources = [], recordDate, note, publishedOn, fetchedOn } = Astro.props;
const safeSources = sources.filter(source => recordSourceUrl(source.url));
---
<aside class="record-provenance" aria-label={title}>
  <h2>{title}</h2>
  {safeSources.length ? <ul>{safeSources.map(source => <li><a href={recordSourceUrl(source.url)!}>{source.label}</a></li>)}</ul> : <p>Original source not recorded for this summary.</p>}
  <dl>{recordDate && <div><dt>{recordDate.label}</dt><dd>{recordDate.value}</dd></div>}{provenanceDates(publishedOn, fetchedOn).map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
  {note && <p>{note}</p>}
  <p>{provenanceExplanation}</p>
</aside>
<style is:global>
  .record-provenance { border-block: 1px solid var(--line); padding-block: 1rem; margin-block: 1.5rem; overflow-wrap: anywhere; }
  .record-provenance h2 { font-size: 1.4rem; }
  .record-provenance dl { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
  .record-provenance dt { font-weight: 600; } .record-provenance dd { margin: 0; }
</style>
