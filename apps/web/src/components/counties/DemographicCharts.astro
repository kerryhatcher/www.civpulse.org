---
import { bibbCounty as county, statisticSource } from '../../data/bibb-county';
const age = county.census.groups.find(group => group.id === 'age')!;
const race = county.census.groups.find(group => group.id === 'race-ethnicity')!;
const poverty = county.census.groups.find(group => group.id === 'poverty')!;
const percent = (value: string) => Number.parseFloat(value);
const bounds = (detail: string) => detail.match(/[\d.]+(?=–)|(?<=–)[\d.]+/g)!.map(Number);
const panels = [
  { id: 'age', label: 'Age', title: 'Every generation, in view.', note: 'Compare the share of residents in each five-year age band. July 1, 2025 estimates.', group: age },
  { id: 'race', label: 'Race & ethnicity', title: 'The people who make up Bibb.', note: 'Race and Hispanic origin describe different, overlapping characteristics. July 1, 2025 estimates.', group: race },
  { id: 'poverty', label: 'Poverty', title: 'A closer look at poverty.', note: 'Rates for all ages and children, with the uncertainty shown. 2024 Census SAIPE estimates.', group: poverty },
];
---
<section class="demographic-charts" aria-labelledby="charts-title" data-demographic-charts>
  <header class="charts-header"><div><h3 id="charts-title">See the story in the numbers</h3><p>Explore Bibb County alongside Georgia.</p></div>
    <div class="charts-key"><span><i aria-hidden="true"></i>Bibb County</span><span><i aria-hidden="true"></i>Georgia</span></div>
  </header>
  <div class="chart-tabs" data-chart-tabs hidden aria-label="Demographic chart topic">
    {panels.map((panel, index) => <button type="button" id={`chart-tab-${panel.id}`} data-chart-tab={panel.id} aria-controls={`chart-panel-${panel.id}`} aria-selected={index === 0 ? 'true' : 'false'}>{panel.label}</button>)}
  </div>
  {panels.map(panel => <section id={`chart-panel-${panel.id}`} data-chart-panel={panel.id} class="chart-panel" aria-labelledby={`chart-title-${panel.id}`}>
    <div class="chart-intro"><h4 id={`chart-title-${panel.id}`}>{panel.title}</h4><p>{panel.note}</p></div>
    {panel.id === 'age' && <figure>
      <figcaption class="chart-scale-caption">Share of all residents · each bar uses a 0–10% scale</figcaption>
      <div class="chart-columns"><span>Age</span><span>0% <span>10%</span></span><span>Bibb / GA</span></div>
      <ol class="age-bars">{age.statistics.map(stat => <li>
        <span class="bar-label">{stat.label.replace('Ages ', '').replace('Age ', '')}</span>
        <div class="bar-pair" aria-hidden="true"><span style={`width:${percent(stat.value) * 10}%`}></span><span style={`width:${percent(stat.georgia) * 10}%`}></span></div>
        <span class="bar-values"><strong>{stat.value}</strong><span>{stat.georgia}</span></span>
      </li>)}</ol>
    </figure>}
    {panel.id === 'race' && <div class="race-charts">
      <figure><figcaption>Race <span>Share of all residents · 0–100% scale</span></figcaption>
        <ol class="race-bars">{race.statistics.slice(0, 6).map(stat => <li>
          <div class="race-label"><span>{stat.label}</span><span class="bar-values"><strong>{stat.value}</strong><span>{stat.georgia}</span></span></div>
          <div class="bar-pair" aria-hidden="true"><span style={`width:${percent(stat.value)}%`}></span><span style={`width:${percent(stat.georgia)}%`}></span></div>
        </li>)}</ol>
      </figure>
      <div class="ethnicity-chart"><h5>Ethnicity is a separate measure</h5><p>Hispanic or Latino residents may be of any race and are included in the race figures.</p>
        <figure><figcaption>Hispanic or Latino, any race <span>Share of all residents · 0–100% scale</span></figcaption>
          <div class="ethnicity-row"><span>Bibb</span><div class="bar-pair" aria-hidden="true"><span style={`width:${percent(race.statistics[6].value)}%`}></span></div><strong>{race.statistics[6].value}</strong></div>
          <div class="ethnicity-row state-row"><span>Georgia</span><div class="bar-pair" aria-hidden="true"><span style={`width:${percent(race.statistics[6].georgia)}%`}></span></div><strong>{race.statistics[6].georgia}</strong></div>
        </figure>
        <p class="chart-footnote">“Alone” means one race. Race shares may differ from 100% due to rounding. Do not add Hispanic origin to the race shares.</p>
      </div>
    </div>}
    {panel.id === 'poverty' && <div class="poverty-charts">
      <p class="chart-scale-caption">Dots show the estimate. Lines show the 90% confidence interval. All plots use a 0–50% scale.</p>
      {poverty.statistics.map(stat => {
        const countyBounds = bounds(stat.detail!); const stateBounds = bounds(stat.stateDetail!);
        return <figure class="poverty-plot"><figcaption>{stat.label}</figcaption>
          <svg viewBox="0 0 600 64" aria-hidden="true" preserveAspectRatio="none">
            {[0, 10, 20, 30, 40, 50].map(tick => <line x1={tick * 12} x2={tick * 12} y1="0" y2="64" class="plot-grid" />)}
            <g class="plot-county"><line x1={countyBounds[0] * 12} x2={countyBounds[1] * 12} y1="20" y2="20" /><circle cx={percent(stat.value) * 12} cy="20" r="5" /></g>
            <g class="plot-state"><line x1={stateBounds[0] * 12} x2={stateBounds[1] * 12} y1="46" y2="46" /><circle cx={percent(stat.georgia) * 12} cy="46" r="5" /></g>
          </svg>
          <div class="plot-ticks" aria-hidden="true">{[0, 10, 20, 30, 40, 50].map(tick => <span>{tick}%</span>)}</div>
          <div class="plot-values"><p><strong>Bibb {stat.value}</strong><span>{stat.detail}</span></p><p><strong>Georgia {stat.georgia}</strong><span>{stat.stateDetail}</span></p></div>
        </figure>;
      })}
      <p class="chart-footnote">Child groups overlap. Rates use each group’s population for whom poverty status is determined. These annual estimates differ from ACS five-year estimates.</p>
    </div>}
    <footer class="chart-footer"><a href={statisticSource(panel.group.statistics[0])}>View the Census source</a><span>Exact figures and definitions are in the topic tables below.</span></footer>
  </section>)}
</section>
<style>
  .demographic-charts { margin-top: 32px; background: var(--paper); border-block: 1px solid var(--line); padding: 32px; }
  .charts-header { display: flex; justify-content: space-between; gap: 24px; align-items: center; }
  h3 { font-size: 2rem; margin-bottom: 8px; }
  p { color: var(--muted); }
  .charts-key { display: flex; gap: 20px; font-size: .85rem; flex-wrap: wrap; }
  .charts-key > span { display: inline-flex; align-items: center; gap: 8px; }
  .charts-key i { width: 10px; height: 10px; background: var(--ink); }
  .charts-key > span + span i { background: var(--rust); }
  .chart-tabs { display: flex; gap: 8px; border-bottom: 1px solid var(--line); margin-top: 24px; padding-bottom: 12px; }
  [hidden] { display: none !important; }
  .chart-tabs button { border: 0; background: transparent; padding: 12px 20px; }
  .chart-tabs button[aria-selected='true'] { background: var(--ink); color: var(--paper); }
  .chart-tabs button:hover:not([aria-selected='true']) { background: var(--sage); }
  .chart-panel { padding-top: 28px; }
  .chart-intro { margin-bottom: 24px; }
  h4 { font-family: var(--serif); font-size: 1.8rem; margin: 0 0 8px; }
  .chart-intro p { max-width: 70ch; font-size: .95rem; }
  figure, ol { margin: 0; }
  ol { padding: 0; list-style: none; }
  .chart-scale-caption { font-size: .8rem; color: var(--muted); margin-bottom: 18px; }
  .chart-columns, .age-bars li { display: grid; grid-template-columns: 70px minmax(0, 1fr) 116px; gap: 16px; align-items: center; }
  .chart-columns { font-size: .75rem; color: var(--muted); padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .chart-columns > span:nth-child(2) { display: flex; justify-content: space-between; }
  .chart-columns > span:last-child { text-align: right; }
  .age-bars li { min-height: 34px; border-bottom: 1px solid var(--canvas); font-size: .85rem; }
  .bar-pair { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .bar-pair > span { height: 7px; background: var(--ink); }
  .bar-pair > span + span, .state-row .bar-pair > span { background: var(--rust); }
  .bar-label { font-variant-numeric: tabular-nums; }
  .bar-values { display: flex; justify-content: flex-end; gap: 16px; font-variant-numeric: tabular-nums; font-size: .85rem; white-space: nowrap; }
  .bar-values strong { color: var(--ink); font-weight: 600; }
  .bar-values > span { color: var(--rust-dark); }
  .race-charts { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; }
  figcaption { font-weight: 600; line-height: 1.5; }
  figcaption > span { display: block; color: var(--muted); font-weight: 400; font-size: .8rem; margin-top: 4px; }
  .race-bars li { margin-top: 24px; }
  .race-label { display: flex; justify-content: space-between; gap: 16px; font-size: .9rem; margin-bottom: 10px; }
  h5 { font-family: var(--serif); font-size: 1.6rem; margin: 0 0 12px; }
  .ethnicity-chart { padding: 24px; background: var(--canvas); align-self: start; }
  .ethnicity-chart > p { font-size: .9rem; }
  .ethnicity-chart figure { margin-top: 24px; }
  .ethnicity-row { display: grid; grid-template-columns: 54px 1fr 48px; align-items: center; gap: 10px; font-size: .85rem; margin-top: 18px; }
  .ethnicity-row strong { text-align: right; font-variant-numeric: tabular-nums; }
  .chart-footnote { font-size: .8rem; margin-top: 24px; max-width: 75ch; }
  .poverty-plot { padding-block: 20px; border-bottom: 1px solid var(--line); max-width: 880px; }
  .poverty-plot svg { display: block; width: 100%; height: 64px; margin-top: 16px; overflow: visible; }
  .plot-grid { stroke: var(--line); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .plot-county { fill: var(--ink); stroke: var(--ink); }
  .plot-state { fill: var(--rust); stroke: var(--rust); }
  .poverty-plot :global(g line) { stroke-width: 3; vector-effect: non-scaling-stroke; }
  .plot-ticks { display: flex; justify-content: space-between; font-size: .75rem; color: var(--muted); margin-top: 6px; }
  .plot-values { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px; font-size: .9rem; }
  .plot-values strong { color: var(--ink); font-weight: 600; }
  .plot-values p + p strong { color: var(--rust-dark); }
  .plot-values span { display: block; font-size: .8rem; margin-top: 4px; }
  .chart-footer { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 20px; margin-top: 28px; font-size: .8rem; color: var(--muted); }
  @media(max-width: 800px) {
    .charts-header { display: block; }
    .charts-key { margin-top: 18px; }
    .race-charts { grid-template-columns: 1fr; gap: 28px; }
  }
  @media(max-width: 560px) {
    .demographic-charts { padding: 24px 16px; margin-inline: -8px; }
    h3 { font-size: 1.7rem; }
    h4 { font-size: 1.5rem; }
    .chart-tabs { gap: 2px; }
    .chart-tabs button { padding: 10px 12px; font-size: .85rem; }
    .chart-columns, .age-bars li { grid-template-columns: 42px minmax(0, 1fr) 88px; gap: 10px; }
    .bar-values { gap: 10px; font-size: .75rem; }
    .age-bars li { min-height: 36px; font-size: .8rem; }
    .ethnicity-chart { padding: 20px 16px; }
    .race-label { flex-wrap: wrap; gap: 6px; }
    .plot-values { gap: 12px; }
  }
</style>
<script>
  import { initDemographicCharts } from '../../scripts/county-charts';
  initDemographicCharts();
</script>
