---
import ProfileEvidence from './ProfileEvidence.astro';
import type { EvidenceSection } from '../lib/profile-evidence';
interface Props { personId?: string; organizationId?: string; published?: EvidenceSection; historyHref?: string }
const { personId, organizationId, published, historyHref } = Astro.props;
---
<section class="profile-articles" data-profile-articles data-person-id={personId} data-organization-id={organizationId} hidden={!published} aria-labelledby="profile-articles-title">
  <h2 id="profile-articles-title">News &amp; articles</h2>
  {published && <ProfileEvidence section={published} historyHref={historyHref} />}
  <p class="status" data-articles-status role="status" aria-live="polite" hidden={!!published}>Loading articles…</p>
  <ul class="profile-article-list" data-profile-article-list></ul>
</section>
