---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Public document archive" description="Search public meeting agendas, minutes, packets and transcripts.">
  <main id="main">
    <div class="page-intro">
      <h1>Public document archive</h1>
      <p>Find published agendas, minutes, meeting packets and transcripts. Search titles, filenames and document contents together. Results link to the source documents and related meetings.</p>
    </div>
    <form class="calendar-filters" data-document-search role="search">
      <label class="field field-wide"><span>Search documents</span><input type="search" name="q" maxlength="500" placeholder="Topic, name or phrase…" /></label>
      <button class="button-link" type="submit" disabled>Search</button>
    </form>
    <p class="status" data-document-status role="status" aria-live="polite">Loading document archive…</p>
    <div class="document-results" data-document-results></div>
    <button type="button" data-document-more hidden>Load more documents</button>
    <p class="body-note">Automated transcripts and OCR may contain errors. Check the original recording or document before quoting them.</p>
  </main>
</Layout>
<script>
  import { initDocuments } from '../scripts/documents';
  void initDocuments();
</script>
