---
import { renderProfileDescription } from '../../lib/profile-description';
import { personPageTitle, recordDescription } from '../../lib/page-metadata';
import { personStructuredData } from '../../lib/structured-data';
import { getProfileSectionBuildData } from '../../lib/profile-section-build-data';
import { emptyProfileSections } from '../../lib/profile-sections';
import { profileEvidence, profileHistoryHref, type EvidenceSection, type ProfileEvidenceKey } from '../../lib/profile-evidence';
import PersonRelationships from '../../components/PersonRelationships.astro';
import { fetchPublicPersonRelationships, type RelatedPerson } from '../../lib/person-relationships';
import ProfileEvidence from '../../components/ProfileEvidence.astro';
import RecordProvenance from '../../components/RecordProvenance.astro';
import { biographySources, biographyProvenanceNote, legislativeVoteScope } from '../../lib/record-provenance';
import { profileSectionUrl } from "../../lib/profile-section-assets";
import ObjectHistoryLink from '../../components/ObjectHistoryLink.astro';
import OfficeTerms from '../../components/OfficeTerms.astro';
import Layout from '../../layouts/Layout.astro';
import ProfileArticles from '../../components/ProfileArticles.astro';
import PersonCandidacies from '../../components/PersonCandidacies.astro';
import PersonVotes from '../../components/PersonVotes.astro';
import {
  fetchPublicAffiliationsByPerson,
  fetchPublicPeople,
  personImageUrl,
  PERSON_KIND_LABELS,
  type OrganizationAffiliation,
  type Person,
} from '../../lib/people';

export async function getStaticPaths() {
  const people = await fetchPublicPeople();
  const affiliations = await fetchPublicAffiliationsByPerson(people.map(person => person.id));
  const relationships = await fetchPublicPersonRelationships(people);
  const sections = await getProfileSectionBuildData();

  return people.map((person) => ({
    params: { slug: person.slug },
    props: { person, related: relationships.get(person.id) ?? [], affiliations: affiliations.get(person.id) ?? [], evidence: profileEvidence(sections.people.get(person.id) ?? emptyProfileSections(), 'people') },
  }));
}

interface Props {
  person: Person;
  related: RelatedPerson[];
  affiliations: OrganizationAffiliation[];
  evidence: Record<ProfileEvidenceKey, EvidenceSection>;
}

const { person, affiliations, evidence, related } = Astro.props;
const history = (key: ProfileEvidenceKey) => profileHistoryHref('people', person.slug, key);
const image = personImageUrl(person.image_path);

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase() ?? '')
    .join('');
}

const address = [
  person.address_line,
  person.address_line2,
  [person.city, person.state].filter(Boolean).join(', ') || null,
  person.postal_code,
]
  .filter((line): line is string => Boolean(line))
  .join('\n');

const contact = [
  { label: 'Email', value: person.email, href: person.email ? `mailto:${person.email}` : null },
  {
    label: 'Phone',
    value: person.phone,
    href: person.phone ? `tel:${person.phone.replace(/[^+\d]/g, '')}` : null,
  },
  {
    label: 'Fax',
    value: person.fax,
    href: person.fax ? `tel:${person.fax.replace(/[^+\d]/g, '')}` : null,
  },
  { label: 'Mailing address', value: address, href: null },
  { label: 'Website', value: person.website_url, href: person.website_url },
  { label: 'Social', value: person.social_url, href: person.social_url },
].filter((item) => item.value);
---

<Layout
  title={personPageTitle(person.full_name, person.title, PERSON_KIND_LABELS[person.kind])}
  description={recordDescription(person.full_name, person.description, `${person.title?.trim() || (person.kind === 'other' ? 'Civic profile' : PERSON_KIND_LABELS[person.kind])}. View recorded roles, organizations and available civic records.`)}
  structuredData={personStructuredData(person, affiliations, new URL(Astro.url.pathname, Astro.site ?? Astro.url), image)}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'People', href: '/people/' }, { name: person.full_name, href: Astro.url.pathname }]}
>
  <main id="main" data-profile-snapshot={await profileSectionUrl("people",person.id)}>
    {person.slug.startsWith('open-ga-6111-fy') && <p><a href={`/finances/?dataset=payroll&year=${person.slug.match(/^open-ga-6111-fy(\d{4})-/)?.[1] ?? ''}&person=${person.id}`}>View this profile's school payroll source record</a></p>}
    <div class="org-header">
      {
        image ? (
          <img
            class="org-header-logo person-header-image"
            src={image}
            alt={`${person.full_name} portrait`}
            width="120"
            height="120"
          />
        ) : (
          <span class="org-header-fallback" aria-hidden="true">
            {initials(person.full_name)}
          </span>
        )
      }
      <div class="org-header-text">
        <p class="org-eyebrow">{PERSON_KIND_LABELS[person.kind]}</p>
        <h1>{person.full_name}</h1>
        {person.title && <p class="org-lede">{person.title}</p>}
      </div>
      <a
        class="button-link org-edit-link"
        data-person-edit-link
        href={`/admin/people/?edit=${person.id}`}
        hidden
      >
        Edit person
      </a>
    </div>

    {person.description && <div class="prose person-bio" set:html={renderProfileDescription(person.description)} />}
    <RecordProvenance title="Biography sources and verification" sources={biographySources(person)} note={biographyProvenanceNote} />

    {
      contact.length > 0 && (
        <div class="org-contact">
          <h2>Contact</h2>
          <dl class="account-list">
            {contact.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>
                  {item.href ? (
                    <a href={item.href}>{item.value}</a>
                  ) : item.label === 'Mailing address' ? (
                    <span class="address-block">{item.value}</span>
                  ) : (
                    item.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    {
      affiliations.length > 0 && (
        <section class="person-affiliations" aria-labelledby="person-affiliations-title">
          <h2 id="person-affiliations-title">Organizations</h2>
          <div class="affiliation-list">
            {affiliations.map((org) => (
              <p class="affiliation-item">
                <a href={`/orgs/${org.slug}/`}>{org.name}</a>
                <span class="affiliation-role"> · {org.role}</span>
              </p>
            ))}
          </div>
        </section>
      )
    }

    <section aria-label="Professional-service reporting"><h2>Reported fees and per diem</h2><p><a href={`/finances/service-fees/?recipient_kind=person&recipient=${person.id}`}>Browse reviewed recipient observations</a>. A receipt does not establish employment, profession or service dates. Missing reports are not zero receipts.</p></section>
    <PersonRelationships personId={person.id} related={related} />
    <OfficeTerms personId={person.id} published={evidence.offices} historyHref={history('offices')} />
    <section data-person-legislation hidden={!evidence['legislative-votes'].rows.length} aria-label="Legislative record">
      <h2>Legislative record</h2><p>{legislativeVoteScope}</p><ProfileEvidence section={evidence['legislative-votes']} historyHref={history('legislative-votes')} />
    </section>

    <PersonVotes personId={person.id} published={evidence.votes} historyHref={history('votes')} />
    <PersonCandidacies personId={person.id} published={evidence.candidacies} historyHref={history('candidacies')} />
    <ProfileArticles personId={person.id} published={evidence.articles} historyHref={history('articles')} />

    <p class="org-back">
      <a href="/people/">← All people</a>
    </p>
  <ObjectHistoryLink feedback table="people" id={person.id} />
  </main>
</Layout>

<script>
  import { initOfficeTerms } from '../../scripts/office-terms';
  initOfficeTerms();
  import { initAdminEditLink } from '../../scripts/auth';
  import { initProfileArticles } from '../../scripts/profile-articles';
  import { initPersonCandidacies } from '../../scripts/person-candidacies';
  import { initPersonVotes } from '../../scripts/person-votes';

  import { initPersonRelationships } from '../../scripts/person-relationships';
  void initPersonRelationships();
  initProfileArticles();
  initPersonCandidacies();
  initPersonVotes();

  void initAdminEditLink();
</script>
