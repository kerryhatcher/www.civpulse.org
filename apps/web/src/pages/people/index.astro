---
import Layout from '../../layouts/Layout.astro';
import { fetchPublicPeople, personImageUrl, PERSON_KIND_LABELS } from '../../lib/people';

const people = await fetchPublicPeople();

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase() ?? '')
    .join('');
}
---

<Layout
  title="People"
  description="Officials, elected office holders, and candidates for office in one public directory."
>
  <main id="main">
    <div class="page-intro">
      <h1>People</h1>
      <p>Officials, elected office holders, and candidates for office.</p>
    </div>

    <form class="people-controls" data-person-search-form role="search">
      <label for="person-search-input">Search people
        <input id="person-search-input" type="search" placeholder="Name or keyword…"
          data-person-search autocomplete="off" maxlength="500" />
      </label>
      <label for="person-kind">Type
        <select id="person-kind" data-person-kind>
          <option value="">All types</option>
          {Object.entries(PERSON_KIND_LABELS).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label for="person-sort">Sort by
        <select id="person-sort" data-person-sort>
          <option value="first_asc">First name: A–Z</option>
          <option value="first_desc">First name: Z–A</option>
          <option value="last_asc">Last name: A–Z</option>
          <option value="last_desc">Last name: Z–A</option>
        </select>
      </label>
      <button type="reset">Clear</button>
    </form>
    <p class="status" data-person-search-note hidden>Admin view includes unlisted and private people.</p>
    <noscript><p>Enable JavaScript to paginate, sort, and filter the directory.</p></noscript>

    <p class="status" data-person-search-status role="status" aria-live="polite" hidden></p>

    {
      people.length > 0 ? (
        <div class="org-grid" data-person-initial>
          {people.map((person) => {
            const image = personImageUrl(person.image_path);
            return (
              <a class="org-card person-card" href={`/people/${person.slug}/`}>
                {image ? (
                  <img
                    class="org-card-logo person-card-image"
                    src={image}
                    alt=""
                    loading="lazy"
                    width="72"
                    height="72"
                  />
                ) : (
                  <span class="org-card-fallback" aria-hidden="true">
                    {initials(person.full_name)}
                  </span>
                )}
                <h2>{person.full_name}</h2>
                <span class="person-card-meta">
                  {[person.title, PERSON_KIND_LABELS[person.kind]].filter(Boolean).join(' · ')}
                </span>
                {person.description && <p>{person.description}</p>}
              </a>
            );
          })}
        </div>
      ) : (
        <div class="prose" data-person-initial>
          <div class="empty-state">
            <p>
              No people are published yet. Admins can add them from{' '}
              <a href="/admin/people/">the people admin</a>.
            </p>
          </div>
        </div>
      )
    }

    <div class="org-grid" id="people-results" data-person-search-results hidden></div>
    <p class="status" data-person-search-empty hidden>No people match your search and filters.</p>
    <nav class="site-search-pagination people-pagination" aria-label="People pages" data-person-pagination hidden>
      <button type="button" data-person-previous aria-controls="people-results">Previous</button>
      <span data-person-page></span>
      <button type="button" data-person-next aria-controls="people-results">Next</button>
    </nav>
  </main>
</Layout>

<script>
  import { initPeopleSearch } from '../../scripts/people';

  initPeopleSearch();
</script>
