---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Your account" description="Manage your Civic Pulse account.">
  <main id="main">
    <div class="page-intro">
      <h1>Your account</h1>
      <p>You're signed in to Civic Pulse.</p>
    </div>
    <div class="prose">
      <div class="account-card" data-account hidden>
        <dl class="account-list">
          <div>
            <dt>Name</dt>
            <dd data-account-name>—</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd data-account-email>—</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd data-account-role>—</dd>
          </div>
          <div>
            <dt>User ID</dt>
            <dd data-account-id>—</dd>
          </div>
        </dl>
        <button class="button-link" type="button" data-account-signout>Sign out</button>
        <section aria-labelledby="connected-apps-title">
          <h2 id="connected-apps-title">Connected apps</h2>
          <p>Apps you have authorized can act with your account's permissions. Revoke access to disconnect an app.</p>
          <p data-grants-status role="status" aria-live="polite">Loading connected apps…</p>
          <ul data-grants-list></ul>
          <button type="button" data-grants-retry hidden>Try again</button>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { initAccount } from '../scripts/auth';

  void initAccount();
</script>
