---
import {calendarAssetUrl} from '../lib/calendar-assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import 'leaflet/dist/leaflet.css';
import { fetchPublicMaps } from '../lib/maps';
import { fetchPublicElections, fetchElectionDetail, formatElectionDate, electionHref } from '../lib/elections';
import { civicDate, electionCalloutStart } from '../lib/election-callout';

const maps = await fetchPublicMaps();
const elections = await fetchPublicElections();
const electionCallouts = (await Promise.all(elections.map(async (election) => {
  const detail = await fetchElectionDetail(election.id);
  const earlyVoting = detail?.dates
    .filter((date) => date.visibility === 'public' && date.election_date_kind === 'early_voting')
    .map((date) => civicDate(new Date(date.starts_at)))
    .sort()[0];
  if (!earlyVoting || earlyVoting > election.election_date) return null;
  return { election, earlyVoting, startsOn: electionCalloutStart(earlyVoting) };
}))).filter((entry) => entry !== null)
  .sort((a, b) => a.election.election_date.localeCompare(b.election.election_date) || a.election.name.localeCompare(b.election.name));
---

<Layout title="A closer look at your community">
  <main id="main">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">A closer look at your community.</h1>
      <p>Follow the decisions, places, and gatherings that shape where you live.</p>
    </section>

    {electionCallouts.map(({ election, earlyVoting, startsOn }) => (
      <section class="home-election-callout" data-election-callout data-starts-on={startsOn}
        data-election-day={election.election_date} data-early-voting={earlyVoting}
        aria-labelledby={`election-${election.id}`} hidden>
        <div>
          <h2 id={`election-${election.id}`}>{election.name}</h2>
          <p class="home-election-status" data-voting-status>Make your plan to vote.</p>
          <p class="home-election-dates">
            Early voting begins <time datetime={earlyVoting}>{formatElectionDate(earlyVoting)}</time>.
            {' '}Election Day is <time datetime={election.election_date}>{formatElectionDate(election.election_date)}</time>.
          </p>
        </div>
        <a class="button-link" href={electionHref(election)} aria-label={`View election details: ${election.name}`}>
          View election details <Icon />
        </a>
      </section>
    ))}

    <div class="home-destinations">
      <section class="destination maps-destination" aria-labelledby="maps-title">
        <header class="destination-heading">
          <h2 id="maps-title">Explore maps</h2>
          <p>Places, precincts, and layers worth knowing.</p>
        </header>
        <div class="destination-body">
          {
            maps.length > 0 ? (
              <div class="map-carousel" data-map-carousel role="region" aria-label="Map previews">
                <div class="map-carousel-viewport" data-carousel-viewport>
                  {maps.map((map, index) => (
                    <article
                      class="map-slide"
                      aria-label={`Map ${index + 1} of ${maps.length}`}
                    >
                      <a
                        class="map-slide-preview-link"
                        href={`/maps/${map.slug}/`}
                        aria-label={`View map: ${map.name}`}
                      >
                        <div class="map-slide-preview" data-map-preview data-map-id={map.id}></div>
                      </a>
                      <div class="map-slide-body">
                        <h3>
                          <a href={`/maps/${map.slug}/`}>{map.name}</a>
                        </h3>
                        {map.description && <p>{map.description}</p>}
                        {map.organizations?.name && (
                          <span class="map-slide-meta">{map.organizations.name}</span>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
                <div class="map-carousel-controls">
                  <span class="map-carousel-count" data-carousel-count></span>
                  <button type="button" data-carousel-prev aria-label="Previous map">
                    <Icon name="chevron-left" />
                  </button>
                  <button type="button" data-carousel-next aria-label="Next map">
                    <Icon name="chevron-right" />
                  </button>
                </div>
              </div>
            ) : (
              <div class="empty-state">
                <p>No public maps are published yet.</p>
              </div>
            )
          }
          <p class="body-note">Previews show each map's default layers.</p>
        </div>
        <a class="destination-link map-cta" href="/maps/">
          Open map explorer <Icon />
        </a>
      </section>

      <section class="destination calendar-destination" aria-labelledby="calendar-title">
        <header class="destination-heading">
          <h2 id="calendar-title">Community calendar</h2>
          <p>Local events, programs and gatherings.</p>
        </header>
        <div class="destination-body">
          <p class="status" data-home-events-status>Loading upcoming events…</p>
          <ul class="home-event-list" data-home-events-list data-home-events-snapshot={await calendarAssetUrl('home')} hidden></ul>
          <p class="status" data-home-events-empty hidden>No upcoming events yet.</p>
          <p class="body-note">The next events from every organization and calendar.</p>
        </div>
        <a class="destination-link calendar-cta" href="/calendar/">
          View the calendar <Icon />
        </a>
      </section>
    </div>

    <script
      type="application/json"
      data-home-maps
      set:html={JSON.stringify(maps)}
      is:inline
    ></script>
  </main>
</Layout>

<script>
  import { initHomeMaps } from '../scripts/home-maps';
  import { initHomeEvents } from '../scripts/home-events';
  import { initHomeElections } from '../scripts/home-elections';

  initHomeMaps();
  initHomeEvents();
  initHomeElections();
</script>
