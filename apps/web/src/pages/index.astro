---
import {calendarAssetUrl} from '../lib/calendar-assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { fetchPublicElections, fetchElectionDetail, electionHref } from '../lib/elections';
import { civicDate, electionCalloutStart } from '../lib/election-callout';

const elections = (await fetchPublicElections()).sort((a, b) => a.election_date.localeCompare(b.election_date) || a.name.localeCompare(b.name));
const electionCallouts = (await Promise.all(elections.map(async (election) => {
  const detail = await fetchElectionDetail(election.id);
  const earlyVoting = detail?.dates
    .filter((date) => date.visibility === 'public' && date.election_date_kind === 'early_voting')
    .map((date) => civicDate(new Date(date.starts_at)))
    .sort()[0];
  if (!earlyVoting || earlyVoting > election.election_date) return null;
  return { election, earlyVoting, startsOn: electionCalloutStart(earlyVoting) };
}))).filter((entry) => entry !== null)
  .sort((a, b) => a.election.election_date.localeCompare(b.election.election_date) || a.election.name.localeCompare(b.election.name));
const topics = [{"id":"people","label":"People","description":"Officials, candidates, and recorded votes.","href":"/people/"},{"id":"organizations","label":"Organizations","description":"Public bodies, local groups, and calendars.","href":"/orgs/"},{"id":"elections","label":"Elections","description":"Dates, races, candidates, and results.","href":"/elections/"},{"id":"calendar","label":"Calendar","description":"Meetings, events, and important dates.","href":"/calendar/"},{"id":"maps","label":"Maps","description":"Places, precincts, and districts.","href":"/maps/"},{"id":"records","label":"Public records","description":"Browse civic records and track records requests.","href":"/records/"}];
---

<Layout title="Your community, in the open">
  <main id="main" class="exhibition-home">
    <section class="exhibition-masthead" aria-label="Civic Pulse search">
      <h1>Civic Pulse</h1>
      <form action="/search/" method="get" role="search" class="exhibition-search">
        <label class="visually-hidden" for="home-query">Find a person, place, or public record</label>
        <input id="home-query" type="search" name="q" maxlength="500" placeholder="Find a person, place, or public record" />
        <button type="submit">Search <Icon /></button>
      </form>
    </section>
    <div class="exhibition-workspace" data-exhibition>
      <nav class="exhibition-index" aria-label="Explore civic topics">
        {topics.map((topic,index) => <a href={'#topic-' + topic.id} data-topic={topic.id} aria-current={topic.id === 'elections' ? 'true' : undefined}>
          <span class="topic-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
          <span class="topic-name">{topic.label}</span>
          <span class="topic-description">{topic.description}</span>
          <Icon size={30} />
        </a>)}
      </nav>
      <div class="exhibition-detail">
        <section id="topic-elections" data-topic-panel="elections" aria-labelledby="elections-heading">
          <h2 id="elections-heading" class="detail-section-title" tabindex="-1"><span aria-hidden="true">03</span> Elections</h2>
          {electionCallouts.map(({election,earlyVoting,startsOn}) => <article class="exhibition-election" data-election-callout data-starts-on={startsOn} data-election-day={election.election_date} data-early-voting={earlyVoting} hidden>
            <h3>{election.name}</h3>
            <p>Find key dates, registration details, what’s on the ballot and more.</p>
            <a class="button-link" href={electionHref(election)}>View election details <Icon /></a>
          </article>)}
          <div class="exhibition-election-fallback">
            <h3>Follow your next election.</h3>
            <p>Explore published dates, races, candidates, and results.</p>
            <ul class="home-election-list">{elections.map(election => <li data-upcoming-election data-election-day={election.election_date} hidden><a href={electionHref(election)}>{election.name}</a></li>)}</ul>
            <p data-home-elections-empty hidden>No upcoming elections are published yet.</p>
            <a class="button-link" href="/elections/">Explore elections <Icon /></a>
          </div>

        </section>
        {topics.filter(topic => topic.id !== 'elections').map(topic => <section id={'topic-' + topic.id} data-topic-panel={topic.id} aria-labelledby={topic.id + '-heading'}>
          <h2 id={topic.id + '-heading'} class="detail-section-title" tabindex="-1"><span aria-hidden="true">{String(topics.indexOf(topic)+1).padStart(2,'0')}</span> {topic.label}</h2>
          <h3 class="exhibition-topic-title">{topic.id === 'people' ? 'Know who represents you.' : topic.id === 'organizations' ? 'Meet your community.' : topic.id === 'calendar' ? 'Be part of what happens next.' : topic.id === 'maps' ? 'A different view of where you live.' : 'Follow the public record.'}</h3>
          <p>{topic.description}</p>
          <a class="button-link" href={topic.href}>Explore {topic.label.toLowerCase()} <Icon /></a>
          {topic.id === 'records' && <div class="exhibition-related"><a href="/requests/">Track records requests <Icon size={16} /></a><a href="/documents/">Search meeting documents <Icon size={16} /></a><a href="/legislation/">Explore legislation <Icon size={16} /></a></div>}
          {topic.id === 'organizations' && <p class="exhibition-related"><a href="/counties/bibb/">Explore the Bibb County community hub <Icon size={16} /></a></p>}
        </section>)}
        <section class="exhibition-dates" aria-labelledby="upcoming-heading">
          <h2 id="upcoming-heading"><a href="/calendar/">Upcoming dates <span class="visually-hidden">— open full calendar</span></a></h2>
          <p class="status" data-home-events-status>Loading upcoming events…</p>
          <ul class="home-event-list" data-home-events-list data-home-events-snapshot={await calendarAssetUrl('home')} hidden></ul>
          <p class="status" data-home-events-empty hidden>No upcoming events yet.</p>
          <noscript><p><a href="/calendar/">Open the community calendar for upcoming dates.</a></p></noscript>

        </section>
      </div>
    </div>
  </main>
</Layout>
<script>
  import { initHomeEvents } from '../scripts/home-events';
  import { initHomeElections } from '../scripts/home-elections';
  import { initExhibition } from '../scripts/home-exhibition';
  initExhibition();
  initHomeEvents();
  initHomeElections();
</script>
