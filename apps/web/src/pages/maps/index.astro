---
import Layout from '../../layouts/Layout.astro';
import 'leaflet/dist/leaflet.css';
import { baseMapLabel } from '../../lib/basemaps';
import { fetchPublicMaps } from '../../lib/maps';

const maps = await fetchPublicMaps();
---

<Layout
  title="Explore maps"
  description="Browse public maps built from OpenStreetMap basemaps and open GeoJSON data."
>
  <main id="main">
    <div class="page-intro">
      <h1>Find your way around.</h1>
      <p>A different view of Macon–Bibb. Choose a map, then make it your own with layers.</p>
    </div>

    <section class="map-explorer-intro" aria-label="Map selection">
      <label class="field"><span>Choose a map</span>
        <select data-map-choice aria-label="Choose a map">{maps.map(map => <option value={map.id}>{map.name}</option>)}</select>
      </label>
      <p data-map-description class="map-description"></p>
    </section>
    <div data-map-explorer><p class="status">Loading maps…</p></div>
    <noscript><p>Enable JavaScript to explore interactive maps. Public map links are listed below.</p></noscript>
    <h2 class="map-browse-heading">Browse all maps</h2>

    <form class="map-search" data-map-search-form role="search">
      <label class="visually-hidden" for="map-search-input">Search maps</label>
      <input
        id="map-search-input"
        type="search"
        placeholder="Search maps…"
        data-map-search
        autocomplete="off"
      />
      <p class="status" data-map-search-note hidden>
        Signed in — search includes public, unlisted, and private maps.
      </p>
    </form>

    <p class="status" data-map-search-status hidden></p>

    {
      maps.length > 0 ? (
        <div class="org-grid" data-map-initial>
          {maps.map((map) => (
            <a class="org-card" href={`/maps/${map.slug}/`}>
              <h2>{map.name}</h2>
              {map.description && <p>{map.description}</p>}
              <span class="map-card-meta">
                {[map.organizations?.name, baseMapLabel(map.base_map)].filter(Boolean).join(' · ')}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="prose" data-map-initial>
          <div class="empty-state">
            <p>
              No public maps are published yet. Admins can add them from{' '}
              <a href="/admin/maps/">the maps admin</a>.
            </p>
          </div>
        </div>
      )
    }

    <div class="org-grid" data-map-search-results hidden></div>
    <p class="status" data-map-search-empty hidden>No maps match that search.</p>
  </main>
</Layout>

<script type="application/json" data-map-catalog set:html={JSON.stringify(maps).replaceAll('<', '\\u003c')} is:inline></script>
<script>
  import { initMapExplorer } from '../../scripts/map-viewer';
  import { initMapSearch } from '../../scripts/map-search';

  initMapSearch();
  initMapExplorer();
</script>
