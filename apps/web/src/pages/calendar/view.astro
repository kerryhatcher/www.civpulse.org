---
import ObjectHistoryLink from '../../components/ObjectHistoryLink.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Event" description="View a shared Civic Pulse calendar event.">
  <main id="main">
    <div class="page-intro">
      <p class="org-eyebrow">Event</p>
    </div>

    <div class="event-viewer-status empty-state" data-event-viewer-status hidden></div>

    <article class="event-detail" data-event-viewer hidden>
      <h1 data-event-title>Event</h1>
      <p class="event-detail-when" data-event-when></p>
      <p class="event-detail-meta" data-event-meta></p>
      <p class="event-detail-location" data-event-location hidden></p>
      <p class="event-detail-election" data-event-election hidden></p>
      <div class="prose event-detail-description" data-event-description hidden></div>
      <p data-event-link hidden>
        <a class="button-link" data-event-url target="_blank" rel="noopener">Event details</a>
      </p>
      <section data-meeting-details hidden class="meeting-details">
        <h2>Meeting record</h2>
        <section data-meeting-notes hidden><h3>Notes and minutes</h3><p data-meeting-notes-text class="meeting-text"></p></section>
        <section data-meeting-transcript hidden><h3>Transcript</h3><p data-meeting-transcript-text class="meeting-text"></p></section>
        <section data-meeting-attendance hidden><h3>Attendance</h3><ul data-meeting-attendance-list></ul></section>
        <section data-meeting-votes hidden><h3>Votes</h3><div data-meeting-vote-list></div></section>
        <section data-meeting-attachments hidden><h3>Attachments</h3><ul data-meeting-attachment-list></ul></section>
      </section>
      <p class="event-detail-actions">
        <a class="button-link event-edit" data-event-edit-link hidden>Edit event</a>
        <a class="event-back" data-event-calendar-link href="/calendar/">← Back to the calendar</a>
      </p>
    </article>
  <ObjectHistoryLink table="events" />
  </main>
</Layout>

<script>
  import { initEventViewFromUrl } from '../../scripts/calendar';

  void initEventViewFromUrl();
</script>
