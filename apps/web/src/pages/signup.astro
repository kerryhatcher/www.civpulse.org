---
import Layout from '../layouts/Layout.astro';
import AuthChallenge from '../components/AuthChallenge.astro';
---

<Layout title="Create an account" description="Create your Civic Pulse account.">
  <main id="main" class="auth-page">
    <div class="auth-card">
      <h1>Join the pulse.</h1>
      <p>Create your Civic Pulse account. Accounts currently have the same content access as public visitors. Saved preferences are coming later.</p>

      <form class="auth-form" data-auth-form="signup">
        <label class="field">
          <span>Name (optional)</span>
          <input type="text" name="display_name" autocomplete="name" maxlength="80" />
        </label>
        <label class="field">
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label class="field">
          <span>Password</span>
          <input
            type="password"
            name="password"
            autocomplete="new-password"
            required
            minlength="8"
          />
        </label>
        <p>Use at least 8 characters for your password.</p>
        <label class="signup-trap" aria-hidden="true">
          Leave this field empty
          <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
        </label>
        <AuthChallenge action="signup" />
        <button class="button-link" type="submit" disabled>Create account</button>
        <p class="auth-message" data-auth-message hidden role="status" aria-live="polite"></p>
      </form>

      <p class="auth-alt">Already have an account? <a href="/signin/">Sign in</a></p>
    </div>
  </main>
</Layout>

<style>
  .signup-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>

<script>
  import { initSignUp } from '../scripts/auth';

  initSignUp();
</script>
