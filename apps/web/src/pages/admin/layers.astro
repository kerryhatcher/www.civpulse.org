---
import Layout from '../../layouts/Layout.astro';
import AdminTabs from '../../components/AdminTabs.astro';
---

<Layout title="Layers admin" description="Manage reusable map layers and import GeoJSON data.">
  <main id="main">
    <div class="page-intro">
      <h1>Layers</h1>
      <p>Reusable map layers that can be added to one or more maps.</p>
    </div>

    <AdminTabs />

    <p class="status" data-admin-gate>Checking access…</p>

    <div class="prose" data-admin-denied hidden>
      <div class="empty-state">
        <p>
          Your account does not have admin access.{' '}
          <a href="/signin/?next=/admin/layers/">Sign in with an admin account</a>.
        </p>
      </div>
    </div>

    <div class="admin-panel" data-admin-panel hidden>
      <form class="org-form" data-layer-form novalidate>
        <h2 data-layer-form-title>Add a layer</h2>
        <input type="hidden" name="id" />

        <div class="field-grid">
          <label class="field">
            <span>Name *</span>
            <input type="text" name="name" maxlength="120" required />
          </label>
          <label class="field">
            <span>Visibility</span>
            <select name="visibility">
              <option value="public">Public</option>
              <option value="unlisted">Unlisted</option>
              <option value="private">Private — admins only</option>
            </select>
          </label>
        </div>

        <label class="field">
          <span>Layer type</span>
          <select name="source_type">
            <option value="geojson">Remote GeoJSON URL</option>
            <option value="postgis">Stored in PostGIS</option>
          </select>
        </label>

        <div data-layer-import hidden>
          <label class="field">
            <span>Import GeoJSON file</span>
            <input type="file" name="geojson_file" accept=".geojson,.json,application/geo+json,application/json" />
          </label>
          <p class="status">Upload a file or provide its URL below. Supports points, lines/paths, polygons, and multi-geometries in WGS84 (longitude, latitude). Limit: 10 MB and 10,000 features. On edit, select replacement data or leave both blank to keep existing features.</p>
          <p class="status">Importing replaces all features when you save. Feature properties and IDs are preserved.</p>
        </div>

        <label class="field">
          <span data-layer-url-label>GeoJSON URL *</span>
          <input
            type="url"
            name="source_url"
            maxlength="1000"
            placeholder="https://example.com/data.geojson"
            required
          />
        </label>

        <p class="status">URLs must allow cross-origin requests (CORS). Stored imports remain available even if the original URL changes.</p>

        <label class="field">
          <span>Description</span>
          <textarea name="description" rows="2" maxlength="2000"></textarea>
        </label>

        <div class="field">
          <span>Default style</span>
          <p class="status">
            Every map shows this style unless it sets its own override.
          </p>
          <div data-layer-style-editor></div>
        </div>

        <div class="org-form-actions">
          <button class="button-link" type="submit">Create layer</button>
          <button type="button" data-layer-cancel hidden>Cancel</button>
        </div>
        <p class="auth-message" data-layer-message hidden role="status" aria-live="polite"></p>
      </form>

      <section aria-labelledby="layer-list-title">
        <h2 id="layer-list-title">All layers</h2>
        <div class="org-list" data-layer-list></div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { initLayerAdmin } from '../../scripts/admin-layers';

  void initLayerAdmin();
</script>
