---
import PublicRequestDetail from '../../../components/PublicRequestDetail.astro';
import type {PublicRequestDetail as RequestDetail} from '../../../lib/request-snapshot';
import {getRequestAssets} from '../../../lib/request-assets';
import LegislationDetail from '../../../components/LegislationDetail.astro';
import type {LegislationDetail as Detail} from '../../../lib/legislation-details';
import {getLegislationDetailAssets} from '../../../lib/legislation-detail-assets';
import EventView from '../../../components/EventView.astro';
import {getPublicCalendarData} from '../../../lib/calendar-build-data';
import {calendarAssetUrl} from '../../../lib/calendar-assets';
import type {EventRecord} from '../../../lib/calendars';
import type {MeetingRecord} from '../../../lib/meetings';
import Layout from '../../../layouts/Layout.astro';
import { getPublicRecordSnapshot } from '../../../lib/public-record-snapshot';
import { archiveHref, recordKinds, type PublicRecord } from '../../../lib/public-records';
export async function getStaticPaths() {
  const [calendar,details,records,requests]=await Promise.all([getPublicCalendarData(),getLegislationDetailAssets(),getPublicRecordSnapshot(),getRequestAssets()]);
  const events=new Map(calendar.events.map(event=>[event.id,event]));
  return records.map(record => ({ params: { kind: record.kind, id: record.id }, props: { record,request:record.kind==='requests'?requests.details.get(record.id):undefined,legislation:details.pages.get(`${record.kind==='bills'?'bills':record.kind==='votes'?'legislative_votes':record.kind==='sessions'?'legislative_sessions':''}/${record.id}`),event:record.kind==='events'?events.get(record.id):undefined,meeting:record.kind==='events'?calendar.meetings.get(record.id):undefined } }));
}
interface Props { record: PublicRecord; event?:EventRecord; meeting?:MeetingRecord; legislation?:Detail; request?:RequestDetail }
const { record,event,meeting,legislation,request } = Astro.props;
---
<Layout title={record.title} description={record.description}>
  {request ? <PublicRequestDetail detail={request} /> : legislation ? <LegislationDetail detail={legislation} /> : event ? <EventView event={event} meeting={meeting} snapshotUrl={await calendarAssetUrl(`events/${event.id}`)} /> : (<main id="main">
    <p><a href="/records/">Public record archive</a> / <a href={archiveHref(record.kind)}>{recordKinds[record.kind]}</a></p>
    <div class="page-intro"><h1>{record.title}</h1></div>
    <dl class="account-list">{record.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}</dd></div>)}</dl>
    {record.sections.filter(section => section.text || section.items?.length).map((section, index) => <section class="prose" aria-labelledby={`section-${index}`}>
      <h2 id={`section-${index}`}>{section.title}</h2>
      {section.text && <p class="record-text">{section.text}</p>}
      {section.items?.length && <ul>{section.items.map(item => <li>{item.href ? <a href={item.href}>{item.text}</a> : item.text}</li>)}</ul>}
    </section>)}
    <p>Published snapshot. Changes appear after the next publication. Coverage includes records added to Civic Pulse and may be incomplete. Confirm current information with the original source.</p>
    <p><a href={record.viewer}>Open live record and available files</a> · <a href="/about/#sources">Sources and credits</a></p>
  </main>)}
</Layout>
<style>.record-text { white-space: pre-wrap; overflow-wrap: anywhere; }</style>
