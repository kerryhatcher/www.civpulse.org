---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Community calendar"
  description="Local public meetings, community gatherings, and civic deadlines are coming to the Civic Pulse calendar."
>
  <main id="main">
    <div class="page-intro">
      <h1>Find something to be part of.</h1>
      <p>Public meetings, community gatherings, and deadlines worth knowing.</p>
    </div>
    <div class="prose">
      <div class="empty-state">
        <p>
          The community calendar is being connected. No events are loaded in
          this release. Check back soon, or
          <a href="/#main">return to the homepage</a>.
        </p>
      </div>
    </div>
  </main>
</Layout>
