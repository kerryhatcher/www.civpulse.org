---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="That page isn't on the map.">
  <main id="main" class="auth-page">
    <div class="auth-card">
      <h1>404 — off the map.</h1>
      <p>
        The page you're looking for has moved, or hasn't been built yet. Let's
        get you back to solid ground.
      </p>
      <a class="button-link" href="/">Back to home</a>
    </div>
  </main>
</Layout>
