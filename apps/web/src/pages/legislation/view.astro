---
import {getLegislationDetailAssets} from '../../lib/legislation-detail-assets';
const indexUrl=(await getLegislationDetailAssets()).indexes.bills;
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Bill record"
  description="Bill text, sponsorship, timeline, votes and media coverage."
>
  <main data-legislation-public-index={indexUrl} id="main" data-legislation-view="bills">
    <p>
      <a href="/legislation/">All legislation</a>
    </p>
    <p role="status" data-status>
      Loading bill…
    </p>
    <div data-detail></div>
  </main>
</Layout>
<script>
  import { initLegislationView } from "../../scripts/legislation";
  void initLegislationView();
</script>
