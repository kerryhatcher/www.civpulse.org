---
import {getLegislationDetailAssets} from '../../lib/legislation-detail-assets';
const indexUrl=(await getLegislationDetailAssets()).indexes.legislative_votes;
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Legislative vote"
  description="The question, result and individual recorded choices for a legislative vote."
>
  <main data-legislation-public-index={indexUrl} id="main" data-legislation-view="legislative_votes">
    <p>
      <a href="/legislation/">All legislation</a>
    </p>
    <p role="status" data-status>
      Loading vote…
    </p>
    <div data-detail></div>
  </main>
</Layout>
<script>
  import { initLegislationView } from "../../scripts/legislation";
  void initLegislationView();
</script>
