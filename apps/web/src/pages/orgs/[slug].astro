---
import { profileSectionUrl } from "../../lib/profile-section-assets";
import { recordDescription } from '../../lib/page-metadata';
import { organizationStructuredData } from '../../lib/structured-data';
import { getProfileSectionBuildData } from '../../lib/profile-section-build-data';
import { emptyProfileSections } from '../../lib/profile-sections';
import { profileEvidence, profileHistoryHref, type EvidenceSection, type ProfileEvidenceKey } from '../../lib/profile-evidence';
import ObjectHistoryLink from '../../components/ObjectHistoryLink.astro';
import OfficeTerms from '../../components/OfficeTerms.astro';
import Layout from '../../layouts/Layout.astro';
import ProfileArticles from '../../components/ProfileArticles.astro';
import {
  fetchOrganizations,
  fetchOrganizationRelationships,
  organizationLogoUrl,
  type Organization,
} from '../../lib/organizations';
import { fetchPublicMaps, type MapConfig } from '../../lib/maps';
import { fetchPublicPeopleByOrganization, personImageUrl, type Person } from '../../lib/people';

export async function getStaticPaths() {
  const [organizations, maps, relationships] = await Promise.all([
    fetchOrganizations(), fetchPublicMaps(), fetchOrganizationRelationships(),
  ]);
  const mapByOrganization = new Map<string, MapConfig>(
    maps
      .filter((map) => map.organization_id !== null)
      .map((map) => [map.organization_id as string, map] as const),
  );
  const peopleByOrganization = await fetchPublicPeopleByOrganization(organizations.map(org => org.id));
  const sections = await getProfileSectionBuildData();

  const organizationById = new Map(organizations.map((org) => [org.id, org]));
  return organizations.map((org) => {
    const related = relationships.flatMap((link) => {
      const forward = link.organization_id === org.id;
      if (!forward && link.related_organization_id !== org.id) return [];
      const organization = organizationById.get(forward ? link.related_organization_id : link.organization_id);
      return organization ? [{ organization,
        relationship: forward ? link.relationship : link.reverse_relationship, source_url: link.source_url }] : [];
    }).sort((a, b) => a.organization.name.localeCompare(b.organization.name));
    return {
      params: { slug: org.slug },
      props: {
        org,
        evidence: profileEvidence(sections.organizations.get(org.id) ?? emptyProfileSections(), 'orgs'),
        related,
        map: mapByOrganization.get(org.id) ?? null,
        people: peopleByOrganization.get(org.id) ?? [],
      },
    };
  });
}

interface Props {
  org: Organization;
  evidence: Record<ProfileEvidenceKey, EvidenceSection>;
  map: MapConfig | null;
  people: { person: Person; role: string }[];
  related: { organization: Organization; relationship: string; source_url: string | null }[];
}

const { org, map, people, related, evidence } = Astro.props;
const logo = organizationLogoUrl(org.logo_path);

const registration = [
  { label: 'Control number', value: org.sos_control_number },
  { label: 'Business type', value: org.sos_business_type },
  { label: 'Registration status', value: org.sos_status },
  { label: 'Formation date', value: org.sos_formation_date },
  { label: 'Last annual registration', value: org.sos_last_annual_registration },
  { label: 'Principal office', value: org.sos_principal_office },
  { label: 'Registered agent', value: org.sos_registered_agent },
  { label: 'County', value: org.sos_county },
  { label: 'NAICS code / description', value: org.sos_naics_code },
  { label: 'Officers', value: org.sos_officers },
].filter(item => item.value);

const contact = [
  { label: 'Email', value: org.email, href: org.email ? `mailto:${org.email}` : null },
  {
    label: 'Phone',
    value: org.phone,
    href: org.phone ? `tel:${org.phone.replace(/[^+\d]/g, '')}` : null,
  },
  { label: 'Address', value: org.address_line, href: null },
  { label: 'Website', value: org.website_url, href: org.website_url },
  { label: 'Social', value: org.social_url, href: org.social_url },
].filter((item) => item.value);
---

<Layout title={`${org.name} — Organization profile`} description={recordDescription(org.name, org.description, 'View contact information, recorded relationships and related public civic records.')}
  structuredData={organizationStructuredData(org, new URL(Astro.url.pathname, Astro.site ?? Astro.url), logo)}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Organizations', href: '/orgs/' }, { name: org.name, href: Astro.url.pathname }]}
>
  <main id="main" data-profile-snapshot={await profileSectionUrl("organizations",org.id)}>
    <section aria-label="Professional-service reporting"><h2>Professional-service fees and per diem</h2><p><a href={`/finances/service-fees/?organization=${org.id}`}>Browse this organization’s reported fees and expenses</a> or <a href={`/finances/service-fees/?recipient_kind=organization&recipient=${org.id}`}>its receipts as a reviewed recipient</a>. Coverage may be missing; this is separate from payroll and payment ledgers.</p></section>
    <p><a href={`/finances/obligations/?organization=${org.id}`}>Browse reported obligations for this organization</a></p>
    <p><a href={`/finances/fees/?organization=${org.id}`}>Browse reported user fees for this organization</a></p>
    {org.slug === 'bibb-county-board-of-education' && <p><a href="/finances/">Search this organization's school payroll and payments</a></p>}
    <div class="org-header">
      {
        logo ? (
          <img class="org-header-logo" src={logo} alt={`${org.name} logo`} width="120" height="120" />
        ) : (
          <span class="org-header-fallback" aria-hidden="true">
            {org.name.slice(0, 1).toUpperCase()}
          </span>
        )
      }
      <div class="org-header-text">
        <p class="org-eyebrow">Organization</p>
        <h1>{org.name}</h1>
        {org.description && <p class="org-lede">{org.description}</p>}
      </div>
      <a
        class="button-link org-edit-link"
        data-org-edit-link
        href={`/admin/organizations/?edit=${org.id}`}
        hidden
      >
        Edit organization
      </a>
    </div>

    <div class="org-contact">
      <h2>Contact</h2>
      <dl class="account-list">
        {
          contact.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>
                {item.href ? (
                  <a href={item.href}>{item.value}</a>
                ) : (
                  item.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
      {map && (
        <p class="org-map">
          <a class="button-link" href={`/maps/${map.slug}/`}>View map: {map.name}</a>
        </p>
      )}
      <p class="org-map">
        <a class="button-link" href={`/calendar/?organization=${org.id}`}>
          View meetings and events
        </a>
      </p>
    </div>

    {
      people.length > 0 && (
        <section class="person-affiliations" aria-labelledby="org-people-title">
          <h2 id="org-people-title">People</h2>
          <div class="people-grid">
            {people.map(({ person, role }) => {
              const image = personImageUrl(person.image_path);
              return (
                <a class="person-card-inline" href={`/people/${person.slug}/`}>
                  {image ? (
                    <img
                      class="person-card-image"
                      src={image}
                      alt=""
                      loading="lazy"
                      width="56"
                      height="56"
                    />
                  ) : (
                    <span class="person-card-fallback" aria-hidden="true">
                      {person.full_name.slice(0, 1).toUpperCase()}
                    </span>
                  )}
                  <span class="person-card-inline-text">
                    <span class="person-card-inline-name">{person.full_name}</span>
                    <span class="person-card-inline-role">{role}</span>
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    {related.length > 0 && (
      <section class="person-affiliations" aria-labelledby="related-organizations-title">
        <h2 id="related-organizations-title">Related organizations</h2>
        <div class="org-grid">
          {related.map(({ organization, relationship, source_url }) => (
            <article class="org-card">
              <h3><a href={`/orgs/${organization.slug}/`}>{organization.name}</a></h3>
              <p>{relationship}</p>
              {source_url && <a href={source_url}>Relationship source</a>}
            </article>
          ))}
        </div>
      </section>
    )}

    {(registration.length > 0 || org.sos_record_url) && (
      <section class="org-contact" aria-labelledby="org-registration-title">
        <h2 id="org-registration-title">Georgia business registration</h2>
        <p>Details from compiled research. Registration status and officers may have changed.</p>
        <dl class="account-list">
          {registration.map(item => <div><dt>{item.label}</dt><dd style="white-space: pre-line">{item.value?.replaceAll("**", "")}</dd></div>)}
        </dl>
        {org.sos_record_url && <p><a href={org.sos_record_url}>View Georgia SOS record</a></p>}
      </section>
    )}

    <section class="org-contact"><h2>Records requests</h2><p><a href={`/requests/?organization=${org.id}`}>View requests to or from {org.name}</a></p></section>
    <OfficeTerms organizationId={org.id} published={evidence.offices} historyHref={profileHistoryHref('orgs', org.slug, 'offices')} />
    <ProfileArticles organizationId={org.id} published={evidence.articles} historyHref={profileHistoryHref('orgs', org.slug, 'articles')} />

    <div class="org-contact">
      <p class="org-back">
        <a href="/orgs/">← All organizations</a>
      </p>
    </div>
  <ObjectHistoryLink feedback table="organizations" id={org.id} />
  </main>
</Layout>

<script>
  import { initOfficeTerms } from '../../scripts/office-terms';
  initOfficeTerms();
  import { initProfileArticles } from '../../scripts/profile-articles';
  import { initAdminEditLink } from '../../scripts/auth';

  initProfileArticles();

  void initAdminEditLink();
</script>
