---
import OfficeTerms from '../../components/OfficeTerms.astro';
import Layout from '../../layouts/Layout.astro';
import ProfileArticles from '../../components/ProfileArticles.astro';
import {
  fetchOrganizations,
  fetchOrganizationRelationships,
  organizationLogoUrl,
  type Organization,
} from '../../lib/organizations';
import { fetchPublicMaps, type MapConfig } from '../../lib/maps';
import { fetchPublicPeopleForOrganization, personImageUrl, type Person } from '../../lib/people';

export async function getStaticPaths() {
  const [organizations, maps, relationships] = await Promise.all([
    fetchOrganizations(), fetchPublicMaps(), fetchOrganizationRelationships(),
  ]);
  const mapByOrganization = new Map<string, MapConfig>(
    maps
      .filter((map) => map.organization_id !== null)
      .map((map) => [map.organization_id as string, map] as const),
  );
  const peopleByOrganization = new Map<string, { person: Person; role: string }[]>();

  await Promise.all(
    organizations.map(async (org) => {
      peopleByOrganization.set(org.id, await fetchPublicPeopleForOrganization(org.id));
    }),
  );

  const organizationById = new Map(organizations.map((org) => [org.id, org]));
  return organizations.map((org) => {
    const related = relationships.flatMap((link) => {
      const forward = link.organization_id === org.id;
      if (!forward && link.related_organization_id !== org.id) return [];
      const organization = organizationById.get(forward ? link.related_organization_id : link.organization_id);
      return organization ? [{ organization,
        relationship: forward ? link.relationship : link.reverse_relationship, source_url: link.source_url }] : [];
    }).sort((a, b) => a.organization.name.localeCompare(b.organization.name));
    return {
      params: { slug: org.slug },
      props: {
        org,
        related,
        map: mapByOrganization.get(org.id) ?? null,
        people: peopleByOrganization.get(org.id) ?? [],
      },
    };
  });
}

interface Props {
  org: Organization;
  map: MapConfig | null;
  people: { person: Person; role: string }[];
  related: { organization: Organization; relationship: string; source_url: string | null }[];
}

const { org, map, people, related } = Astro.props;
const logo = organizationLogoUrl(org.logo_path);

const contact = [
  { label: 'Email', value: org.email, href: org.email ? `mailto:${org.email}` : null },
  {
    label: 'Phone',
    value: org.phone,
    href: org.phone ? `tel:${org.phone.replace(/[^+\d]/g, '')}` : null,
  },
  { label: 'Address', value: org.address_line, href: null },
  { label: 'Website', value: org.website_url, href: org.website_url },
  { label: 'Social', value: org.social_url, href: org.social_url },
].filter((item) => item.value);
---

<Layout title={org.name} description={org.description ?? `Contact details for ${org.name}.`}>
  <main id="main">
    <div class="org-header">
      {
        logo ? (
          <img class="org-header-logo" src={logo} alt={`${org.name} logo`} width="120" height="120" />
        ) : (
          <span class="org-header-fallback" aria-hidden="true">
            {org.name.slice(0, 1).toUpperCase()}
          </span>
        )
      }
      <div class="org-header-text">
        <p class="org-eyebrow">Organization</p>
        <h1>{org.name}</h1>
        {org.description && <p class="org-lede">{org.description}</p>}
      </div>
      <a
        class="button-link org-edit-link"
        data-org-edit-link
        href={`/admin/organizations/?edit=${org.id}`}
        hidden
      >
        Edit organization
      </a>
    </div>

    <div class="org-contact">
      <h2>Contact</h2>
      <dl class="account-list">
        {
          contact.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>
                {item.href ? (
                  <a href={item.href}>{item.value}</a>
                ) : (
                  item.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
      {map && (
        <p class="org-map">
          <a class="button-link" href={`/maps/${map.slug}/`}>View map: {map.name}</a>
        </p>
      )}
    </div>

    {
      people.length > 0 && (
        <section class="person-affiliations" aria-labelledby="org-people-title">
          <h2 id="org-people-title">People</h2>
          <div class="people-grid">
            {people.map(({ person, role }) => {
              const image = personImageUrl(person.image_path);
              return (
                <a class="person-card-inline" href={`/people/${person.slug}/`}>
                  {image ? (
                    <img
                      class="person-card-image"
                      src={image}
                      alt=""
                      loading="lazy"
                      width="56"
                      height="56"
                    />
                  ) : (
                    <span class="person-card-fallback" aria-hidden="true">
                      {person.full_name.slice(0, 1).toUpperCase()}
                    </span>
                  )}
                  <span class="person-card-inline-text">
                    <span class="person-card-inline-name">{person.full_name}</span>
                    <span class="person-card-inline-role">{role}</span>
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    {related.length > 0 && (
      <section class="person-affiliations" aria-labelledby="related-organizations-title">
        <h2 id="related-organizations-title">Related organizations</h2>
        <div class="org-grid">
          {related.map(({ organization, relationship, source_url }) => (
            <article class="org-card">
              <h3><a href={`/orgs/${organization.slug}/`}>{organization.name}</a></h3>
              <p>{relationship}</p>
              {source_url && <a href={source_url}>Relationship source</a>}
            </article>
          ))}
        </div>
      </section>
    )}

    <OfficeTerms organizationId={org.id} />
    <ProfileArticles organizationId={org.id} />

    <div class="org-contact">
      <p class="org-back">
        <a href="/orgs/">← All organizations</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  import { initOfficeTerms } from '../../scripts/office-terms';
  initOfficeTerms();
  import { initProfileArticles } from '../../scripts/profile-articles';
  import { initAdminEditLink } from '../../scripts/auth';

  initProfileArticles();

  void initAdminEditLink();
</script>
