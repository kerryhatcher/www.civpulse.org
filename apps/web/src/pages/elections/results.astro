---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Election results & turnout" description="Sourced election reports for Macon-Bibb, with turnout and reporting history.">
 <main id="main" class="results-page">
  <div class="page-intro"><h1>Election results &amp; turnout</h1><p>Explore Macon-Bibb votes and participation, countywide or in your precinct.</p></div>
  <form id="result-form" class="result-election-form">
   <label for="result-election">Election</label>
   <div class="result-election-controls"><select id="result-election" required><option value="">Choose an election</option></select><button type="submit">Refresh reports</button></div>
  </form>
  <fieldset id="result-filters" disabled>
   <legend>Explore a report</legend>
   <div class="result-filter-grid">
    <div><label for="result-area">Reporting area</label><select id="result-area"><option value="">County overview</option></select></div>
    <div><label for="result-method">Voting method</label><select id="result-method"><option value="all">All voting methods</option></select></div>
    <div id="result-style-field"><label for="result-style">Ballot style</label><select id="result-style"><option value="all">All ballot styles</option></select></div>
    <label for="result-search" class="result-search-label">Find a contest or candidate<input id="result-search" type="search" placeholder="e.g. Governor or a candidate’s name" /></label>
   </div>
  </fieldset>
  <label class="result-history-label"><input id="result-history" type="checkbox" /> Include earlier reports for this selection</label>
  <p id="result-status" role="status" aria-live="polite">Loading elections…</p>
  <button id="result-retry" type="button" hidden>Try loading reports again</button>
  <p class="result-explainer">Each view stands on its own. County totals already include precinct and voting-method results; these reports are never added together. “Not reported” is different from zero.</p>
  <div id="result-reports"></div>
  <noscript><p>JavaScript is needed to load the latest election reports. Enable it and reload this page.</p></noscript>
  <p class="result-footer"><a href="/elections/">All elections</a> · <a href="/docs/admins/#election-results-and-turnout">Import results with an AI agent</a></p>
 </main>
</Layout>
<script>
 import { initElectionResults } from '../../scripts/election-results';
 void initElectionResults();
</script>
<style>
 .results-page { max-width: 1120px; }
 .page-intro { margin-bottom:1rem; }
 .page-intro h1 { font-size:clamp(2rem,4vw,3rem); }
 .result-election-form { margin-block: 1rem; }
 label, legend { font-weight: 600; }
 .result-election-controls { display:flex; gap: .75rem; margin-top: .5rem; }
 .result-election-controls select { flex: 1; min-width: 0; }
 select, input[type="search"] { width:100%; min-width:0; min-height:48px; padding:.7rem; border:1px solid var(--line); border-radius:var(--radius); background:var(--paper); color:var(--ink); font-weight:400; }
 button { min-height:48px; padding:.7rem 1rem; border:1px solid var(--line); border-radius:var(--radius); background:var(--paper); }
 fieldset { margin:0; padding:1.25rem 0; border:0; border-block:1px solid var(--line); }
 legend { padding:0 .5rem 0 0; }
 .result-filter-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; }
 .result-filter-grid > div, .result-filter-grid label { min-width:0; }
 .result-filter-grid select, .result-filter-grid input { margin-top:.5rem; }
 #result-style-field[hidden] { display:none; }
 .result-search-label { grid-column:1 / -1; }
 .result-history-label { display:flex; align-items:center; gap:.65rem; min-height:48px; margin-top:.75rem; font-weight:400; }
 .result-history-label input { width:1.15rem; height:1.15rem; accent-color:var(--ink); }
 #result-status { margin-block:.75rem; color:var(--muted); }
 .result-explainer { max-width:75ch; font-size:.9rem; color:var(--muted); }
 .result-footer { margin-top:2rem; }
 #result-reports :global(.result-report) { margin-top:2rem; padding-top:1.5rem; border-top:1px solid var(--line); }
 #result-reports :global(h2) { font-size:2rem; }
 #result-reports :global(.result-report-label) { margin-top:.65rem; font-weight:600; }
 #result-reports :global(.result-time) { color:var(--muted); margin-top:.25rem; }
 #result-reports :global(.result-metrics) { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1rem; margin:1.5rem 0; padding:1rem 0; border-block:1px solid var(--line); }
 #result-reports :global(dt) { color:var(--muted); font-size:.9rem; }
 #result-reports :global(dd) { margin:.5rem 0 0; font-weight:600; font-size:1.2rem; font-variant-numeric:tabular-nums; }
 #result-reports :global(.result-audit) { margin-block:.75rem; color:var(--muted); font-size:.9rem; }
 #result-reports :global(.result-audit summary) { padding:.65rem 0; cursor:pointer; }
 #result-reports :global(.result-audit p) { max-width:75ch; overflow-wrap:anywhere; margin-block:.5rem; }
 #result-reports :global(.result-contest-count) { margin:2rem 0 1rem; font-size:1.5rem; }
 #result-reports :global(.result-contest) { border-top:1px solid var(--line); }
 #result-reports :global(.result-contest > summary) { cursor:pointer; padding:1.1rem .25rem; font-weight:600; line-height:1.5; }
 #result-reports :global(.result-contest > summary:hover) { background:var(--paper); }
 #result-reports :global(.result-vote-total) { display:block; margin-left:1.25rem; font-size:.9rem; font-weight:400; color:var(--muted); font-variant-numeric:tabular-nums; }
 #result-reports :global(table) { border-collapse:collapse; width:100%; margin-block:.5rem 1rem; font-variant-numeric:tabular-nums; }
 #result-reports :global(caption) { text-align:left; font-size:.85rem; color:var(--muted); padding-bottom:.75rem; }
 #result-reports :global(th), #result-reports :global(td) { text-align:right; padding:.75rem .5rem; border-bottom:1px solid var(--line); }
 #result-reports :global(th:first-child) { text-align:left; width:65%; overflow-wrap:anywhere; }
 #result-reports :global(tbody th) { font-weight:400; }
 #result-reports :global(td) { white-space:nowrap; }
 @media(max-width:700px) {
  .result-filter-grid { grid-template-columns:1fr; }
  .result-election-controls { flex-direction:column; }
  #result-reports :global(.result-metrics) { grid-template-columns:repeat(2,minmax(0,1fr)); }
  #result-reports :global(th), #result-reports :global(td) { padding:.75rem .25rem; }
 }
</style>
