---
import '../styles/global.css';
import '@fontsource/unna/400.css';
import '@fontsource/unna/700.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import { GEORGIA_COUNTIES, DEFAULT_COUNTY } from '../lib/county-scope';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Civic Pulse helps residents follow local decisions, find community events, and explore the places that shape where they live.',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const groups = [
  { label: 'Community', links: [
    { url: '/maps/', label: 'Maps' },
    { url: '/calendar/', label: 'Calendar' },
    { url: '/people/', label: 'People' },
    { url: '/orgs/', label: 'Organizations' },
  ] },
  { label: 'Government', links: [
    { url: '/elections/', label: 'Elections' },
    { url: '/legislation/', label: 'Legislation' },
    { url: '/requests/', label: 'Records requests' },
  ] },
  { label: 'Research & help', links: [
    { url: '/records/', label: 'Public record archive' },
    { url: '/documents/', label: 'Meeting documents' },
    { url: '/docs/', label: 'Guides & help' },
    { url: '/about/', label: 'About Civic Pulse' },
  ] },
];
const isCurrent = (url: string) => path === url.replace(/\/+$/, '') || path.startsWith(url);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1e7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · Civic Pulse`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title} · Civic Pulse</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a href="/" class="brand" aria-label="Civic Pulse home">
          <img
            src="/brand/civic-pulse.svg"
            alt="Civic Pulse"
            width="257"
            height="48"
          />
        </a>
        <nav aria-label="Main navigation">
          <label class="county-picker">
            <span class="visually-hidden">County</span>
            <svg class="county-picker-location" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
            <select data-county-filter aria-describedby="county-help">
              <option value="all">All counties</option>
              {GEORGIA_COUNTIES.map(county => <option value={county.fips} selected={county.fips === DEFAULT_COUNTY}>{county.name} County</option>)}
            </select>
            <svg class="county-picker-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
          </label>
          <span id="county-help" class="visually-hidden">Filters civic browsing. Saved for this tab’s session. Statewide and unclassified records are included.</span>
          <details class="browse-menu" data-browse-menu>
            <summary>Browse</summary>
            <div class="browse-panel">
              {groups.map((group) => (
                <section aria-label={group.label}>
                  <h2>{group.label}</h2>
                  {group.links.map((item) => (
                    <a href={item.url} aria-current={isCurrent(item.url) ? 'page' : undefined}>{item.label}</a>
                  ))}
                </section>
              ))}
            </div>
          </details>
          <a href="/calendar/" aria-current={isCurrent('/calendar/') ? 'page' : undefined}>Calendar</a>
          <a href="/search/" aria-current={isCurrent('/search/') ? 'page' : undefined}>Search</a>
          <a data-nav-admin href="/admin/organizations/" hidden>Admin</a>
          <a data-nav-auth href="/signin/">Sign in</a>
        </nav>
      </header>
      <p class="county-status" data-county-status role="status"></p>
      <slot />
      <footer class="site-footer">
        <p>
          Civic Pulse <span aria-hidden="true">·</span> A clearer signal from your
          community
        </p>
        <nav aria-label="Footer navigation">
          <a href="/about/">About</a>
          <a href="/docs/">Guides & help</a>
          <a href="/search/">Search</a>
        </nav>
      </footer>
    </div>
  </body>
</html>

<script>
  import { initAuthNav } from '../scripts/auth';
  import { initCountyFilter } from '../scripts/county-filter';
  initCountyFilter();
  void initAuthNav();
  const menu = document.querySelector<HTMLDetailsElement>('[data-browse-menu]');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>
