---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import '@fontsource/anton/400.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Civic Pulse helps residents follow local decisions, find community events, and explore the places that shape where they live.',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const groups = [
  { label: 'Community', links: [
    { url: '/maps/', label: 'Maps' },
    { url: '/calendar/', label: 'Calendar' },
    { url: '/people/', label: 'People' },
    { url: '/orgs/', label: 'Organizations' },
  ] },
  { label: 'Government', links: [
    { url: '/elections/', label: 'Elections' },
    { url: '/legislation/', label: 'Legislation' },
    { url: '/requests/', label: 'Records requests' },
  ] },
  { label: 'Research & help', links: [
    { url: '/records/', label: 'Public record archive' },
    { url: '/documents/', label: 'Meeting documents' },
    { url: '/docs/', label: 'Guides & help' },
    { url: '/about/', label: 'About Civic Pulse' },
  ] },
];
const isCurrent = (url: string) => path === url.replace(/\/+$/, '') || path.startsWith(url);
const isHome = path === '/';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0838d7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090f20" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · Civic Pulse`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title} · Civic Pulse</title>
  </head>
  <body class:list={{ 'home-page': isHome }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        {isHome ? <a class="site-location" href="/counties/bibb/">Bibb County, Georgia <Icon size={16} /></a> : <a href="/" class="brand" aria-label="Civic Pulse home">Civic Pulse<span aria-hidden="true">.</span></a>}
        <nav aria-label="Main navigation">
          <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a>
          <details class="browse-menu" data-browse-menu>
            <summary>Browse</summary>
            <div class="browse-panel">
              {groups.map((group) => (
                <section aria-label={group.label}>
                  <h2>{group.label}</h2>
                  {group.links.map((item) => (
                    <a href={item.url} aria-current={isCurrent(item.url) ? 'page' : undefined}>{item.label}</a>
                  ))}
                </section>
              ))}
            </div>
          </details>
          <a href="/calendar/" aria-current={isCurrent('/calendar/') ? 'page' : undefined}>Calendar</a>
          <a href="/search/" aria-current={isCurrent('/search/') ? 'page' : undefined}>Search</a>
          <a data-nav-admin href="/admin/organizations/" hidden>Admin</a>
          <a data-nav-auth href="/signin/">Sign in</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        {!isHome && <p>Civic Pulse <span aria-hidden="true">/</span> Public information. Open to everyone.</p>}
        <nav aria-label="Footer navigation">
          <a href="/about/">About</a>
          <a href="/docs/">Guides & help</a>
          <a href="/search/">Search</a>
          {isHome && <a href="/elections/">All elections</a>}
        </nav>
        {isHome && <a class="footer-local" href="/counties/bibb/">Explore Bibb County <Icon /></a>}
      </footer>
    </div>
  </body>
</html>

<script>
  import { initAuthNav } from '../scripts/auth';
  void initAuthNav();
  const menu = document.querySelector<HTMLDetailsElement>('[data-browse-menu]');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>
