# Public Supabase project settings (safe to expose in the browser)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Required for hosted Supabase builds. Use a production widget restricted to your domains.
# Loopback Supabase automatically uses Cloudflare's public testing sitekey.
PUBLIC_TURNSTILE_SITEKEY=
# Never put a Turnstile secret here; configure it in Supabase Auth CAPTCHA settings.

# Optional override for local media Worker testing (default: https://media.civpulse.org)
# PUBLIC_MEDIA_URL=http://localhost:8787
