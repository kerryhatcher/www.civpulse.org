{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "civpulse-web-new",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "new.civpulse.org",
      "custom_domain": true
    }
  ]
}
