      "css": ".ds-secondary{min-height:44px;padding:10px 14px;border:1px solid var(--control-line,#758291);border-radius:var(--radius,6px);background:var(--paper,#f6f7f2);color:var(--ink,#111815);font:400 16px \"Barlow\",sans-serif;cursor:pointer}.ds-secondary:hover:not(:disabled){background:var(--sage,#daf868)}.ds-secondary:disabled{opacity:.5;cursor:default}.ds-secondary:focus-visible{outline:3px solid var(--focus,#0838d7);outline-offset:5px}@media(prefers-color-scheme:dark){.ds-secondary:hover:not(:disabled){color:var(--selected-ink,#111815)}}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Paper input with line border and blue focus.",
      "html": "<label class=\"ds-field\">Search<input class=\"ds-input\" placeholder=\"Find public information\" /></label>",
      "css": ".ds-field{display:grid;gap:6px;color:var(--ink,#111815);font:500 14px \"Barlow\",sans-serif}.ds-input{min-height:44px;padding:10px 12px;border:1px solid var(--control-line,#758291);border-radius:var(--radius,6px);background:var(--paper,#f6f7f2);color:var(--ink,#111815);font:400 16px \"Barlow\",sans-serif;caret-color:var(--blue,#0838d7)}.ds-input::placeholder{color:var(--muted,#485254)}.ds-input:focus-visible{outline:3px solid var(--focus,#0838d7);outline-offset:5px}"
    },
    {
      "name": "Header navigation",
      "kind": "nav",
      "description": "Fixed pale canvas text with lime underline in both appearances.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example\"><a href=\"#about\" aria-current=\"page\">About</a><a href=\"#signin\">Sign in</a></nav>",
      "css": ".ds-nav{display:flex;gap:24px;padding:8px 16px;background:var(--canvas,#0838d7);font:400 16px \"Barlow\",sans-serif}.ds-nav a{position:relative;display:flex;align-items:center;min-height:44px;min-width:44px;color:var(--on-canvas,#f6f7f2);text-decoration:none}.ds-nav a:after{content:\"\";position:absolute;bottom:4px;left:0;right:0;height:2px;background:var(--lime,#daf868);transform:scaleX(0);transform-origin:left;transition:transform 180ms cubic-bezier(.16,1,.3,1)}.ds-nav a:hover:after,.ds-nav a[aria-current=\"page\"]:after{transform:scaleX(1)}.ds-nav a:focus-visible{outline:3px solid var(--lime,#daf868);outline-offset:5px}"
    },
    {
      "name": "Visibility badge",
      "kind": "chip",
      "description": "Informational access label used on permitted search results.",
      "html": "<span class=\"ds-badge\">Private</span>",
      "css": ".ds-badge{display:inline-block;align-self:flex-start;padding:2px 6px;border:1px solid var(--line,#b8c1cd);font:600 11px \"Barlow\",sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--rust-dark,#062baa)}"
    },
    {
      "name": "Directory card",
      "kind": "card",
      "description": "Square paper record with border emphasis on hover.",
      "html": "<article class=\"ds-card\"><h2><a href=\"#record\">Community organization</a></h2><p>Public bodies, local groups, and calendars.</p></article>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:12px;padding:22px;border:1px solid var(--line,#b8c1cd);border-radius:0;background:var(--paper,#f6f7f2);color:var(--ink,#111815);transition:border-color 160ms ease}.ds-card:hover{border-color:var(--ink,#111815)}.ds-card h2{margin:0;font:600 24px/1.08 \"Barlow Condensed\",sans-serif}.ds-card p{margin:0;font:400 16px/1.6 \"Barlow\",sans-serif}.ds-card a{color:inherit;text-underline-offset:5px}.ds-card a:focus-visible{outline:3px solid var(--focus,#0838d7);outline-offset:5px}"
    },
    {
      "name": "Selected topic",
      "kind": "custom",
      "refersTo": "topic-selected",
      "description": "Lime index selection with fixed dark text in both appearances.",
      "html": "<a class=\"ds-topic\" href=\"#topic-elections\" aria-current=\"true\"><span class=\"ds-number\">03</span><span class=\"ds-name\">Elections</span><span class=\"ds-description\">Dates, races, candidates, and results.</span><svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg></a>",
      "css": ".ds-topic{display:grid;grid-template-columns:38px minmax(0,.94fr) minmax(0,1.06fr) 36px;gap:18px;align-items:center;min-height:96px;padding:23px 14px;border-radius:var(--radius,6px);background:var(--lime,#daf868);color:var(--selected-ink,#111815);text-decoration:none}.ds-number{font:600 23px \"Barlow Condensed\",sans-serif;font-variant-numeric:tabular-nums}.ds-name{font:700 clamp(28px,3vw,46px)/1.05 \"Barlow\",sans-serif;letter-spacing:-.04em}.ds-description{font:400 17px/1.35 \"Barlow\",sans-serif}.ds-topic:focus-visible{outline:3px solid var(--paper,#f6f7f2);outline-offset:5px}"
    },
    {
      "name": "Exhibition detail",
      "kind": "custom",
      "refersTo": "detail-panel",
      "description": "Lime light panel and olive dark panel with a numbered topic identifier.",
      "html": "<section class=\"ds-detail\"><h2 class=\"ds-detail-label\"><span>03</span> Elections</h2><h3 class=\"ds-detail-title\">Follow your next election.</h3><p class=\"ds-detail-copy\">Explore published dates, races, candidates, and results.</p></section>",
      "css": ".ds-detail{background:var(--panel,#daf868);color:var(--ink,#111815);padding:30px 32px 6px;border-radius:var(--radius,6px)}.ds-detail-label{margin:2px 0 14px;font:600 17px/1.2 \"Barlow\",sans-serif;letter-spacing:.08em;text-transform:uppercase}.ds-detail-label span{margin-right:24px;letter-spacing:0}.ds-detail-title{margin:0 0 14px;font:400 clamp(40px,5.85vw,96px)/1.08 \"Anton\",sans-serif;letter-spacing:-.025em;overflow-wrap:anywhere}.ds-detail-copy{font:400 26px/1.2 \"Barlow\",sans-serif}@media(prefers-color-scheme:dark){.ds-detail-title{color:var(--lime,#daf868)}}"
    }
  ],
  "narrative": {
    "northStar": "Open Exhibition",
    "overview": "Civic Pulse presents public information with the directness of exhibition signage: monumental condensed headings, a saturated ultramarine ground, and precise topic labels. Paper reading surfaces and lime selection surfaces keep dense civic information readable inside that expressive identity. The browser/system appearance preference automatically switches the canvas and reading surfaces to navy while retaining lime selection and pale reading text.\n\nThe name remains geographically expandable. Bibb County, Georgia appears as separate location context, without suggesting that other county hubs already exist. This document records implemented styles; it does not certify a finish-review verdict. Source authority is `src/styles/global.css`, `src/layouts/Layout.astro`, and the implemented homepage and search scripts. The approved composition and review screenshots provide visual context; source values take precedence.",
    "keyCharacteristics": [
      "Monumental Anton display typography with readable Barlow labels and prose.",
      "Ultramarine/light and navy/dark canvases, distinct reading surfaces, and acid-lime selected topics.",
      "Numbered, ruled topic navigation and compact date indexes.",
      "Flat surfaces, restrained rounding, and explicit keyboard focus."
    ],
    "rules": [
      {
        "name": "Surface Contrast",
        "body": "Use on-canvas text on the canvas, ink text on reading surfaces, and fixed selected-ink text on lime; select the focus color for the surface underneath it.",
        "section": "colors"
      },
      {
        "name": "Display and Reading",
        "body": "Reserve Anton for identity and major headings; use Barlow for explanatory copy and controls.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep geographic context separate from the Civic Pulse name.",
      "Do pair monumental display headings with readable Barlow body copy.",
      "Do use lime for selected topics and preserve fixed dark text on that lime surface.",
      "Do distinguish visible control boundaries from decorative separators.",
      "Do preserve visible keyboard focus, reduced-motion behavior, and automatic system appearance.",
      "Do preserve source map colors, icons, historical records, and version notes."
    ],
    "donts": [
      "Don't turn every reading surface into a floating or heavily rounded card.",
      "Don't imply geographic coverage or civic capabilities that are not available.",
      "Don't expose hidden data to achieve a visual composition; static Astro and visibility-aware reads remain binding."
    ]
  }
}
