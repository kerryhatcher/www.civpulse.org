{
  "name": "civpulse",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "worktree:setup": "bun run scripts/setup-worktree.mjs",
    "dev:worktree": "ASTRO_DEV_BACKGROUND=1 bun run dev:web",
    "dev": "bun run scripts/dev.mjs",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:backend": "supabase start",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "check": "bun run --cwd apps/web check",
    "check:migrations": "bun run scripts/check-migrations.mjs",
    "publish:test": "bun test scripts/tests/publish-handler.test.ts",
    "publish:check": "bun run --cwd apps/web tsc --noEmit --strict --skipLibCheck --target es2022 --module esnext --moduleResolution bundler --lib es2022,dom ../../supabase/functions/publish/handler.ts",
    "mcp:check": "bun run --cwd apps/mcp check",
    "georgia:check": "bun run --cwd apps/georgia-source check",
    "georgia:test": "bun test scripts/tests/georgia-source.test.ts scripts/tests/georgia-reader.test.ts",
    "georgia:deploy": "bun run georgia:check && bun run georgia:test && bun run --cwd apps/georgia-source deploy",
    "mcp:test": "bun run scripts/test-mcp-auth.mjs",
    "mcp:deploy": "bun run check:migrations && bun run mcp:check && bun run mcp:build && SUPABASE_TELEMETRY_DISABLED=1 bunx supabase functions deploy mcp --project-ref drzcrodqflzkzzbqsags",
    "deploy": "bun run --cwd apps/web deploy",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "db:push": "bun run scripts/push-production-migrations.mjs",
    "db:status": "supabase status",
    "db:seed-user": "bun run scripts/seed-test-user.mjs",
    "secret:scan": "bun run scripts/secret-scan.mjs",
    "secret:scan:all": "bun run scripts/secret-scan.mjs --all",
    "security:trivy": "trivy fs --scanners vuln,secret,misconfig --ignorefile .trivyignore.yaml --skip-dirs '**/node_modules' --skip-dirs '**/dist' --skip-dirs '**/.astro' --skip-dirs '**/.git' --skip-dirs '**/supabase/.temp' --skip-dirs '**/.wrangler' --skip-files '**/.dev.vars' .",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/*",
    "check:pins": "bun run scripts/check-action-pins.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "plugin:build": "bun run scripts/build-plugin.mjs",
    "media:check": "bun run --cwd apps/media check",
    "media:test": "bun run --cwd apps/media test",
    "media:deploy": "bun run --cwd apps/media deploy",
    "kb:check": "bun run --cwd apps/kb check",
    "kb:test": "bun run --cwd apps/kb test",
    "kb:dev": "bun run --cwd apps/kb dev",
    "mcp:build": "bun run scripts/build-mcp.mjs"
  },
  "devDependencies": {
    "supabase": "^2.121.0",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "undici@7": "7.30.1"
  }
}
