{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "civpulse": {
      "type": "streamable-http",
      "url": "https://api.civpulse.org/functions/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://api.civpulse.org/functions/v1/mcp",
            "defaultScopes": [
              "openid",
              "email",
              "profile",
              "offline_access"
            ],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
