{
  "mcpServers": {
    "civpulse": {
      "type": "streamable-http",
      "url": "https://mcp.civpulse.org/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://mcp.civpulse.org/mcp",
            "defaultScopes": [
              "openid",
              "email",
              "profile",
              "offline_access"
            ],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
